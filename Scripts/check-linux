#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 WITH Swift-exception
# Copyright (c) 2026 Xudong Xu
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ $(swift --version 2>/dev/null || true) != *'Swift version 6.3.'* ]]; then
  case "$(uname -m)" in
    x86_64) platform=ubuntu24.04; channel=ubuntu2404 ;;
    aarch64) platform=ubuntu24.04-aarch64; channel=ubuntu2404-aarch64 ;;
    *) echo 'Unsupported validation architecture' >&2; exit 2 ;;
  esac
  toolchain_dir="$PWD/.build/toolchains/swift-6.3.1"
  mkdir -p "$toolchain_dir"
  if [[ ! -x "$toolchain_dir/usr/bin/swift" ]]; then
    archive="swift-6.3.1-RELEASE-$platform.tar.gz"
    url="https://download.swift.org/swift-6.3.1-release/$channel/swift-6.3.1-RELEASE/$archive"
    curl --fail --location --output "$toolchain_dir/archive.tar.gz" "$url"
    curl --fail --location --output "$toolchain_dir/archive.tar.gz.sig" "$url.sig"
    curl --compressed --fail --location --output "$toolchain_dir/release-key.asc" \
      https://www.swift.org/keys/release-key-swift-6.x.asc
    mkdir -p "$toolchain_dir/keyring"
    chmod 700 "$toolchain_dir/keyring"
    gpg --homedir "$toolchain_dir/keyring" --import "$toolchain_dir/release-key.asc"
    gpg --homedir "$toolchain_dir/keyring" --status-fd 1 --verify \
      "$toolchain_dir/archive.tar.gz.sig" "$toolchain_dir/archive.tar.gz" > "$toolchain_dir/signature.txt"
    python3 - "$toolchain_dir/signature.txt" <<'PY'
import pathlib, sys
assert 'VALIDSIG 52BB7E3DE28A71BE22EC05FFEF80A866B47A981F ' in pathlib.Path(sys.argv[1]).read_text()
PY
    tar xzf "$toolchain_dir/archive.tar.gz" -C "$toolchain_dir" --strip-components=1
  fi
  export PATH="$toolchain_dir/usr/bin:$PATH"
fi
Scripts/check
